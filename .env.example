# ============================================
# datascience_admin Environment Variables
# ============================================
# Copy this file to .env and fill in the values.

# --- Portfolio Settings ---
PORTFOLIO_PROFILE_ID=segun-banji
PORTFOLIO_OWNER_NAME=Segun Banji
ADMIN_APP_NAME=Segun Banji Admin
PORTFOLIO_SITE_URL=https://banjisegun.vercel.app

# --- Admin Authentication ---
# REQUIRED: Set a strong password for admin login.
ADMIN_PASSWORD=change-me

# REQUIRED for production: Secret key for session signing.
# If not set, a random key is generated per process (sessions lost on restart).
ADMIN_SECRET_KEY=

# Optional: Alternative secret key name (FASTHTML_SECRET_KEY is checked if ADMIN_SECRET_KEY is empty)
# FASTHTML_SECRET_KEY=

# --- Session Security ---
# Session timeout in seconds (default: 86400 = 24 hours, minimum: 300 = 5 minutes)
SESSION_TIMEOUT_SECONDS=86400

# --- Supabase Configuration ---
# REQUIRED: Your Supabase project URL
SUPABASE_URL=

# REQUIRED: Service role key (for full access) or anon key (read-only)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Optional: Supabase request timeout in seconds (default: 10, minimum: 8)
SUPABASE_TIMEOUT_SECONDS=10

# Optional: Storage bucket name (default: portfolio-images)
SUPABASE_STORAGE_BUCKET=portfolio-images

# --- Security Settings ---
# Optional: PBKDF2 iterations for password hashing (default: 180000)
PBKDF2_ITERATIONS=180000

# Optional: Auth page portrait image URL
ADMIN_AUTH_PORTRAIT_URL=https://pdfsfspkptysfowokzgi.supabase.co/storage/v1/object/public/portfolio-images/profile/1779887668-5779de3f-profile.jpeg
